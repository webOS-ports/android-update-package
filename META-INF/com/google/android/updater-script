ui_print("");
ui_print("Welcome to the LuneOS RootFS Updater");
ui_print("");

show_progress(1.000000, 180);

ui_print("Mounting system and userdata partitions...");
run_program("/sbin/mount","/system");
run_program("/sbin/mount","/data");
set_progress(0.100000);

ui_print("Copying the LuneOS rootfs tarball...");
package_extract_file("webos-rootfs.tar.gz", "/data/webos-rootfs.tar.gz") || (
    delete("/data/webos-rootfs.tar.gz");
    abort("Could not copy the rootfs tarball to /data, is it full? Nothing was installed.")
);
# Optional: the space the unpacked rootfs takes, for webos_deploy.sh's space check
package_extract_file("webos-rootfs.size", "/tmp/webos-rootfs.size");
package_extract_file("busybox-static", "/tmp/busybox-static");
package_extract_file("webos_deploy.sh", "/tmp/webos_deploy.sh");
package_extract_file("ui-print-wrapper.sh", "/tmp/ui-print-wrapper.sh");
set_perm(0, 0, 0777, "/tmp/busybox-static");
set_perm(0, 0, 0777, "/tmp/webos_deploy.sh");
set_perm(0, 0, 0777, "/tmp/ui-print-wrapper.sh");
set_progress(0.300000);

ui_print("Deploying LuneOS...");
# run_program returns the wait status as a string, so anything but "0" is a
# failure. Stop here then: flashing the kernel would pair it with a rootfs that
# was not installed, and the old installation is still bootable, if any is left.
run_program("/tmp/ui-print-wrapper.sh", "/tmp/webos_deploy.sh") == "0" ||
    abort("Deploying LuneOS failed, see the messages above. The kernel was not flashed.");
set_progress(0.700000);

ui_print("Flashing kernel ...");
package_extract_file("boot.img", "###BOOT_PARTITION###");
set_progress(0.900000);

unmount("/data");
unmount("/system");
run_program("/sbin/sync");
set_progress(1.000000);
ui_print("Installation completed, please reboot!");
